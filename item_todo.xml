package com.example.todoapp.ui.add

import android.net.Uri
import android.os.Bundle
import android.view.View
import androidx.activity.result.PickVisualMediaRequest
import androidx.activity.result.contract.ActivityResultContracts
import androidx.fragment.app.Fragment
import androidx.fragment.app.viewModels
import androidx.navigation.fragment.findNavController
import com.bumptech.glide.Glide
import com.example.todoapp.R
import com.example.todoapp.TodoApplication
import com.example.todoapp.data.TodoEntity
import com.example.todoapp.databinding.FragmentAddTodoBinding
import com.example.todoapp.util.ImageStorageUtil
import com.example.todoapp.viewmodel.TodoViewModel
import com.example.todoapp.viewmodel.TodoViewModelFactory

class AddTodoFragment : Fragment(R.layout.fragment_add_todo) {

    private var _binding: FragmentAddTodoBinding? = null
    private val binding get() = _binding!!

    private val viewModel: TodoViewModel by viewModels {
        TodoViewModelFactory((requireActivity().application as TodoApplication).repository)
    }

    // Photo Picker — no runtime storage permission required.
    private var selectedImageUri: Uri? = null

    private val pickMedia = registerForActivityResult(ActivityResultContracts.PickVisualMedia()) { uri ->
        if (uri != null) {
            selectedImageUri = uri
            showImagePreview(uri)
        }
        // If uri is null, the user canceled the picker — nothing to do, previous state stays.
    }

    override fun onViewCreated(view: View, savedInstanceState: Bundle?) {
        super.onViewCreated(view, savedInstanceState)
        _binding = FragmentAddTodoBinding.bind(view)

        binding.btnBack.setOnClickListener { findNavController().popBackStack() }

        binding.imagePickerContainer.setOnClickListener { launchPhotoPicker() }
        binding.layoutImagePlaceholder.setOnClickListener { launchPhotoPicker() }

        binding.btnRemoveImage.setOnClickListener {
            selectedImageUri = null
            clearImagePreview()
        }

        binding.btnSave.setOnClickListener { saveTodo() }
    }

    private fun launchPhotoPicker() {
        pickMedia.launch(
            PickVisualMediaRequest(ActivityResultContracts.PickVisualMedia.ImageOnly)
        )
    }

    private fun showImagePreview(uri: Uri) {
        binding.imgPreview.visibility = View.VISIBLE
        binding.layoutImagePlaceholder.visibility = View.GONE
        binding.btnRemoveImage.visibility = View.VISIBLE
        Glide.with(this).load(uri).centerCrop().into(binding.imgPreview)
    }

    private fun clearImagePreview() {
        binding.imgPreview.visibility = View.GONE
        binding.layoutImagePlaceholder.visibility = View.VISIBLE
        binding.btnRemoveImage.visibility = View.GONE
        Glide.with(this).clear(binding.imgPreview)
    }

    private fun saveTodo() {
        val title = binding.editTitle.text?.toString()?.trim().orEmpty()
        val description = binding.editDescription.text?.toString()?.trim().orEmpty()

        if (title.isEmpty()) {
            binding.tilTitle.error = getString(R.string.title_required_error)
            return
        }
        binding.tilTitle.error = null

        // Persist the picked image into internal storage so it survives app restarts.
        val persistedImagePath = selectedImageUri?.let { uri ->
            ImageStorageUtil.saveImageToInternalStorage(requireContext(), uri)
        }

        viewModel.insert(
            TodoEntity(
                title = title,
                description = description,
                imagePath = persistedImagePath
            )
        )

        findNavController().popBackStack()
    }

    override fun onDestroyView() {
        super.onDestroyView()
        _binding = null
    }
}
